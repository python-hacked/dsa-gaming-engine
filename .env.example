# Copy this file to .env in the same folder (project root).
# .env stays on your machine. Hugging Face pe yahi names Secrets me daalne hain.
# cp .env.example .env

# --- App (step 1) ---
APP_ENV=local
APP_BASE_URL=http://127.0.0.1:8000
SESSION_SECRET=replace-with-openssl-rand-hex-32

# --- Postgres / Supabase (step 2) ---
# Local docker: postgresql+asyncpg://dsa:dsa@127.0.0.1:5432/dsa_gaming
# Deploy: Supabase pooler, port 6543.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:6543/postgres

# --- Google login (step 3) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# --- Code runner, DSA languages (step 6) ---
PISTON_API_URL=https://emkc.org/api/v2/piston

# --- SQL sandbox, alag locked role, sirf SELECT (step 8) ---
SQL_LAB_DATABASE_URL=postgresql+asyncpg://sql_lab_runner:PASSWORD@HOST:6543/postgres

# --- Coach LLM, ek provider bharo (step 10) ---
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
GEMINI_API_KEY=
